NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]?[params]

# --- Demo microservices RabbitMQ (user-service / email-service) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
USER_SERVICE_PORT=3001

# --- user-service: database riêng, độc lập với DATABASE_URL của app gốc ---
USER_SERVICE_DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[database]?[params]
